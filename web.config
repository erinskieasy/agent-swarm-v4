<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="dist/server/index.js" verb="*" modules="iisnode"/>
    </handlers>
    <rewrite>
      <rules>
        <!-- Serve static files from dist/client -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="^dist/client/(.*)" />
          <action type="Rewrite" url="dist/client/{R:1}" />
        </rule>
        <!-- All API and event requests go to Node.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True"/>
          </conditions>
          <match url=".*" />
          <action type="Rewrite" url="dist/server/index.js"/>
        </rule>
      </rules>
    </rewrite>
    <iisnode nodeProcessCommandLine="node"
            watchedFiles="web.config;*.js"
            loggingEnabled="true"
            logDirectory="iisnode" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin"/>
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
